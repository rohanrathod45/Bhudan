# Server
PORT=5000
NODE_ENV=production

# --- Database -------------------------------------------------------------
# Leave MONGO_URI empty to run in built-in DEMO mode (in-memory seeded store).
# For permanent account persistence across deploys/restarts, provide MongoDB Atlas URI:
# NOTE FOR MONGODB ATLAS:
# Go to MongoDB Atlas -> Network Access -> IP Access List -> Add IP Address -> Select "Allow Access from Anywhere" (0.0.0.0/0).
# Otherwise cloud hosts like Render will be blocked by Atlas firewall!
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/bhudan?retryWrites=true&w=majority
DEMO_SEED=true

# --- Auth -----------------------------------------------------------------
# Strong secret for JWT signing in production (at least 32 characters)
JWT_SECRET=change_this_to_a_long_random_string_for_production
JWT_EXPIRES=7d

# --- Client (CORS) --------------------------------------------------------
# Comma-separated list of allowed frontend origins (NO trailing slashes)
# Example:
CLIENT_URL=https://your-frontend-app.vercel.app,http://localhost:5173

# --- Demo Administrator (seeded when DEMO_SEED=true and users collection is empty) ---
ADMIN_EMAIL=admin@bhudan.gov.in
ADMIN_PASSWORD=Admin@12345