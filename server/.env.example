# Server
PORT=5000
NODE_ENV=development

# --- Database -------------------------------------------------------------
# Leave MONGO_URI empty to run in built-in DEMO mode (in-memory seeded store).
# Provide a MongoDB connection string to use a real database, e.g.:
# MONGO_URI=mongodb://127.0.0.1:27017/bhudan
MONGO_URI=
DEMO_SEED=true

# --- Auth -----------------------------------------------------------------
# Generate a strong secret. In production use at least 32 random characters.
JWT_SECRET=change_this_to_a_long_random_string_for_production
JWT_EXPIRES=7d

# --- Client ---------------------------------------------------------------
# Origin(s) allowed by CORS (comma separated).
CLIENT_URL=http://localhost:5173

# --- Demo access (only used when DEMO_SEED=true and no users exist) -------
ADMIN_EMAIL=admin@bhudan.gov.in
ADMIN_PASSWORD=Admin@12345